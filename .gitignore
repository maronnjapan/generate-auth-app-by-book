node_modules/
dist/
.wrangler/
.data/

# ローカルの設定と秘密情報（各ディレクトリの .env.example を .env にコピーして使う）
.env
.env.*
!.env.example

# ログと OS のファイル
*.log
.DS_Store

# 生成 AI ツールのローカル設定（共有するのは .claude/settings.json と .claude/commands/ だけ）
.claude/settings.local.json

