# 第3章 認証基盤（OpenID Provider）のローカル検証用設定。
# .env にコピーして使う。すべて省略可能で、省略時は右の既定値になる。

# 認証基盤の待ち受けと issuer（OP 自身の URL）
HOST=localhost
PORT=4000
ISSUER=http://localhost:4000

# 発行するトークンの署名鍵の kid（鍵自体は起動のたびに生成する）
OIDC_SIGNING_KEY_ID=chapter3-rs256-key

# サンプル CLI アプリ（public client。Device Authorization Grant を使う）
SAMPLE_CLI_CLIENT_ID=sample-cli

# サンプル API（confidential client。/introspect の呼び出しに使う）
SAMPLE_API_URL=http://localhost:4001
SAMPLE_API_CLIENT_ID=sample-api
SAMPLE_API_CLIENT_SECRET=sample-api-secret
